{
  "name": "faucet",
  "version": "0.2.0",
  "private": true,
  "description": "Faucet — buyback-and-burn engine and site for Robinhood on Pons (Robinhood Chain). Every creator reward buys the coin back and burns it.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "faucet": "node dist/src/cli.js",
    "policy": "node dist/src/cli.js policy",
    "plan": "node dist/src/cli.js plan",
    "doctor": "node dist/src/cli.js doctor",
    "status": "node dist/src/cli.js status",
    "serve": "node scripts/serve.mjs",
    "sync:fallback": "node scripts/sync-fallback.mjs",
    "build:info": "node scripts/build-info.mjs",
    "cycle": "node dist/src/cli.js burn --mock --execute --rounds 6 --seed 42 --write-site && npm run sync:fallback && npm run build:info"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
