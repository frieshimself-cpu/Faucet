# ── Robinhood Chain ──────────────────────────────────────────────────────────
# Fill these from the Robinhood Chain and Pons documentation for the launch.
# `faucet doctor` refuses to run live until every one of them is set and the
# RPC reports the same chain id.
FAUCET_RPC_URL=
FAUCET_CHAIN_ID=
# Transaction link prefix for the explorer, e.g. https://explorer.example/tx/
FAUCET_EXPLORER_TX=

# ── Contracts ────────────────────────────────────────────────────────────────
# The token contract.
FAUCET_TOKEN=
# UniswapV2Router02-compatible router the pool trades on, and its wrapped ETH.
FAUCET_ROUTER=
FAUCET_WETH=

# ── The dev wallet ───────────────────────────────────────────────────────────
# Pons pays creator rewards here. The engine spends everything above the gas
# reserve buying the token, with the swap output delivered to the burn address.
FAUCET_DEV_WALLET=
# Private key of that wallet. Needed ONLY for `faucet burn --execute`.
# NEVER commit this. Keep it in a secret store, not in a file next to the code.
FAUCET_DEV_WALLET_KEY=
