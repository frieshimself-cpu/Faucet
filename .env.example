# ── Robinhood Chain ──────────────────────────────────────────────────────────
# Defaults are built in (chain id 4663, the public RPC and the Blockscout
# explorer) and were verified against mainnet. Override only if you run your
# own node.
# FAUCET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# FAUCET_CHAIN_ID=4663
# FAUCET_EXPLORER_TX=https://robinhoodchain.blockscout.com/tx/

# ── The launch ───────────────────────────────────────────────────────────────
# The token contract, as launched on Pons v2.
FAUCET_TOKEN=
# Optional: the ticker to show if it is not ROBIN.
# FAUCET_TOKEN_SYMBOL=ROBIN

# ── The dev wallet ───────────────────────────────────────────────────────────
# The wallet that launched the token: Pons credits its creator rewards to this
# address in the fee escrow. The engine claims them, spends everything above the
# gas reserve buying the token, and delivers the tokens to the burn address.
FAUCET_DEV_WALLET=
# Private key of that wallet. Needed ONLY to claim and to buy (`run`, `--execute`).
# NEVER commit this. Export it in the runner's shell or a secret store, not in a
# file next to the code. The engine refuses to sign if the key is not the
# wallet above.
FAUCET_DEV_WALLET_KEY=

# ── Pons v2 and Uniswap v4 on Robinhood Chain ────────────────────────────────
# Built in and verified; override only if Pons redeploys.
# FAUCET_PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# FAUCET_PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# FAUCET_PONS_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
# FAUCET_V4_UNIVERSAL_ROUTER=0x8876789976decbfcbbbe364623c63652db8c0904
# FAUCET_V4_QUOTER=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
# FAUCET_V4_STATE_VIEW=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b

# ── Limits (wei) ─────────────────────────────────────────────────────────────
# FAUCET_GAS_RESERVE_WEI=1000000000000000     # 0.001 ETH kept for gas
# FAUCET_MIN_BUYBACK_WEI=2000000000000000     # 0.002 ETH: below this, nothing is bought
# FAUCET_MIN_CLAIM_WEI=500000000000000        # 0.0005 ETH: below this, rewards stay in the escrow
