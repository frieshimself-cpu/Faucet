# RPC endpoint for the chain the token lives on (Solana mainnet by default).
FAUCET_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: authenticated RPC for higher rate limits.
# FAUCET_RPC_URL=https://your-provider.example/?api-key=...

# Signer for the distributor. NEVER commit a real key.
# Path to a keypair file; the engine reads it only for `cycle --execute`.
FAUCET_TREASURY_KEYPAIR=./.secrets/treasury.json
