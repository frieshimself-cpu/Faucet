{
  "name": "faucet",
  "version": "0.3.0",
  "private": true,
  "description": "Faucet \u2014 buyback-and-burn engine and site for Robinhood on Pons (Robinhood Chain). Every three minutes: claim the creator rewards from the Pons fee escrow, buy the coin with all of them, burn it.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "faucet": "node dist/src/cli.js",
    "policy": "node dist/src/cli.js policy",
    "plan": "node dist/src/cli.js plan",
    "doctor": "node dist/src/cli.js doctor",
    "status": "node dist/src/cli.js status",
    "run:live": "node dist/src/cli.js run --every 180 --commit-every 30",
    "demo": "node dist/src/cli.js burn --mock --execute --rounds 6 --seed 42 --write-site",
    "reset": "node dist/src/cli.js reset --yes && npm run sync:fallback && npm run build:info",
    "serve": "node scripts/serve.mjs",
    "sync:fallback": "node scripts/sync-fallback.mjs",
    "build:info": "node scripts/build-info.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.36",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
